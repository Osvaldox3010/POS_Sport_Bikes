# ==========================================================
# BikePOS — Variables de entorno de ejemplo
# Copiar como ".env" (local) o configurar como secretos en
# Render / Cloudflare Pages / GitHub Actions según corresponda.
# NUNCA subir el archivo ".env" real a Git.
# ==========================================================

# ---------- Base de datos (PostgreSQL — Neon en producción) ----------
DATABASE_URL=jdbc:postgresql://localhost:5432/bikepos
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ---------- Backend / Seguridad ----------
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Súper admin inicial ----------
# Usados una sola vez, en el primer arranque del backend,
# para crear la cuenta de súper admin (ver plan.md, 4.1).
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ---------- Servicio de correo (autorización de precio — Fase 11) ----------
# Proveedor concreto por definir en la Fase 11 (V2 en plan.md, sección 13).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8080/api
